// Provider-wire compat for "github-copilot"; regenerated from the frozen census using deployment contract selectors.

provider "github-copilot" {
	default-model "gpt-5.5"
	env "COPILOT_GITHUB_TOKEN"

	// Replaces the strict-mode provider whitelist entry.
	supports-strict-mode #true
	// Replaces Anthropic request-builder provider checks: Copilot rejects strict
	// tool schemas and does not support the context-management beta or field.
	disable-strict-tools #true
	supports-context-management #false
	// Responses items from an earlier connection answer `401 input item does
	// not belong to this connection`: a resumed session rebuilds prior turns
	// until its first response.
	connection-bound-native-history #true
	// Per-plan API hosts the Copilot token resolves to; the bundled base URL
	// is `api.githubcopilot.com`.
	endpoint-hosts "api.individual.githubcopilot.com" "api.business.githubcopilot.com" \
		"api.enterprise.githubcopilot.com"
	// `/chat/completions`, `/responses` and `/v1/messages` decode zstd, br and
	// gzip request bodies (deflate is rejected), probed live 2026-10. GHE.com
	// tenants (`copilot-api.<tenant>.ghe.com`) are unverified and stay plain.
	request-encodings "zstd" "gzip"
	request-encoding-rejection "invalid_request_body|[Ff]ailed to (?:parse|read) request"
	// Replaces the provider-keyed strict Responses tool-call/result pairing.
	strict-responses-pairing #true
	// Replaces the provider check that disabled reasoning params on chat completions.
	on-api "openai-completions" priority=1 {
		supports-reasoning-params #false
		supports-store #false
		supports-developer-role #false
	}
	models "claude-haiku-4.5" "gpt-5.4-mini" {
		premium-multiplier 0.33
	}
	models "claude-opus-4.6" {
		premium-multiplier 3
	}
	models "gpt-4o" {
		premium-multiplier 0
	}
	models "grok-code-fast-1" {
		premium-multiplier 0.25
	}
	// Copilot caps GPT-5.4 below the lineage's 1M window (model-limits in
	// runtime/behavior.kdl), so the class-wide window patch and uncapped
	// window do not apply here.
	class "openai" {
		models "gpt-5.4" {
			limits-patch {}
			long-context-window-uncapped #false
		}
	}
	class "anthropic" {
		revision ">=4 <4.6" {
			thinking-efforts "minimal" "low" "medium" "high" "xhigh"
		}
	}
	class "gemini" {
		family "flash" {
			supports-developer-role #false
		}
		revision ">=2.5 <3.7" {
			thinking-mode "effort"
		}
	}
	class "kimi" {
		thinking-mode "effort"
	}
	class "openai" {
		revision ">=5 <5.7" {
			thinking-mode "effort"
		}
	}
	class "unknown" {
		thinking-mode "effort"
	}
	class "xai" {
		family "grok" {
			thinking-mode "effort"
		}
	}
	// residue: taxonomy ranks and exact globs do not isolate these models.
	models "gemini-2.5-pro" "gemini-3.1-pro-preview" "gpt-4.1" {
		supports-developer-role #false
	}
	// residue: taxonomy ranks and exact globs do not isolate these models.
	models "gpt-5.1-codex" "gpt-5.1-codex-max" {
		thinking-efforts "minimal" "low" "medium" "high"
	}
	// residue: taxonomy ranks and exact globs do not isolate these models.
	models "gpt-5.1-codex-mini" {
		thinking-efforts "medium" "high"
	}
	// residue: taxonomy ranks and exact globs do not isolate these models.
	models "grok-4.5" "mai-code-1-flash-picker" {
		thinking-efforts "minimal" "low" "medium" "high" "xhigh"
	}
	// Dormant until a catalog snapshot ships grok-4.6: Copilot serves
	// grok-4.6 / grok-4.6-1m only via /responses, whose policy adds the
	// native xhigh tier and drops the chat-completions compat block
	// Discovered rows ride the openai-responses primary route.
	models "grok-4.6" "grok-4.6-1m" {
		thinking-efforts "minimal" "low" "medium" "high" "xhigh"
	}
	// Copilot bills these OpenAI flagships in two tiers: the default tier ends
	// at 272K prompt tokens and the long tier is served as the opt-in `-1m`
	// sibling synthesized from `billing.token_prices.long_context`. Bundled and
	// cached rows carry the long tier's 1.05M ceiling as the base window, and
	// the Copilot rows carry no `cost.longContext`, so the standard-pricing cap
	// had nothing to key on and every session started on the premium tier.
	// Keep the default tier explicit; `/extended-context on` restores the full
	// window. Exact ids only — the `-1m` siblings are the long tier itself.
	models "gpt-5.6-sol" "gpt-5.6-luna" "gpt-5.6-terra" "gpt-6-astra" {
		limits-patch {
			context-window 272000
		}
		max-context-window 1050000
	}
	// Claude Haiku 5.5: `billing.token_prices` reports its input/output rates
	// but no cache legs, so discovered rows priced cache reads and writes at
	// $0. Copilot's rate card bills $0.01 read / $0.125 write up to 100K and
	// $0.05 / $0.625 on the long tier (the `-1m` sibling).
	// https://docs.github.com/en/copilot/reference/copilot-billing/models-and-pricing
	// Copilot serves that tier as the `-1m` row (promotion target of the base
	// row), so both rows opt out of the class-wide 100K 5x band: the base row
	// would otherwise bill the band on top of the promotion, and the `-1m`
	// row would charge 5x twice.
	models "claude-haiku-5.5" {
		cost-patch {
			cache-read 0.01
			cache-write 0.125
		}
		long-context-cost {
		}
	}
	models "claude-haiku-5.5-1m" {
		cost-patch {
			cache-read 0.05
			cache-write 0.625
		}
		long-context-cost {
		}
	}

	// Reviewed offline fallback; runtime discovery remains account-scoped.
	seed base-url="https://api.githubcopilot.com" bundle="always" {
		model "claude-fable-5" name="Claude Fable 5" api="anthropic-messages" int=49.6 {
			reasoning #true
			input "text" "image"
			cost input=10 output=50 cache-read=1 cache-write=12.5
			limits context=1000000 max-tokens=128000
		}
		model "claude-fable-5.1" name="Claude Fable 5.1" api="anthropic-messages" int=53.4 {
			reasoning #true
			input "text" "image"
			cost input=10 output=50 cache-read=0.25 cache-write=12.5
			limits context=1000000 max-tokens=128000
		}
		model "claude-haiku-4.5" name="Claude Haiku 4.5" api="anthropic-messages" {
			reasoning #true
			input "text" "image"
			cost input=1 output=5 cache-read=0.1 cache-write=1.25
			limits context=200000 max-tokens=64000
		}
		model "claude-haiku-5.5" name="Claude Haiku 5.5" api="anthropic-messages" int=43.4 {
			reasoning #true
			input "text" "image"
			cost input=0.1 output=0.5 cache-read=0.01 cache-write=0.125
			limits context=1000000 max-tokens=128000
		}
		model "claude-opus-4.5" name="Claude Opus 4.5" api="anthropic-messages" int=35.6 tps=46.8 {
			reasoning #true
			input "text" "image"
			cost input=5 output=25 cache-read=0.5 cache-write=6.25
			limits context=200000 max-tokens=32000
		}
		model "claude-opus-4.6" name="Claude Opus 4.6" api="anthropic-messages" int=38.8 tps=36.7 {
			reasoning #true
			input "text" "image"
			cost input=5 output=25 cache-read=0.5 cache-write=6.25
			limits context=168000 max-tokens=32000
		}
		model "claude-opus-4.7" name="Claude Opus 4.7" api="anthropic-messages" int=40.7 {
			reasoning #true
			input "text" "image"
			cost input=5 output=25 cache-read=0.5 cache-write=6.25
			limits context=200000 max-tokens=32000
		}
		model "claude-opus-4.8" name="Claude Opus 4.8" api="anthropic-messages" int=41.8 {
			reasoning #true
			input "text" "image"
			cost input=5 output=25 cache-read=0.5 cache-write=6.25
			limits context=200000 max-tokens=64000
		}
		model "claude-opus-5" name="Claude Opus 5" api="anthropic-messages" int=50.8 {
			reasoning #true
			input "text" "image"
			cost input=5 output=25 cache-read=0.5 cache-write=6.25
			limits context=1000000 max-tokens=64000
		}
		model "claude-opus-5.5" name="Claude Opus 5.5" api="anthropic-messages" int=57.6 {
			reasoning #true
			input "text" "image"
			cost input=4 output=20 cache-read=0.2 cache-write=5
