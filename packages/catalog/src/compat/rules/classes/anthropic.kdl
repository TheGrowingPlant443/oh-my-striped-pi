// Model-lineage compat for "anthropic"; regenerated from the frozen census using class taxonomy selectors.

// Images bill ⌈w/28⌉·⌈h/28⌉ visual tokens on every host. Claude 4.7+ and
// Fable/Mythos read up to 2576px and 4,784 tokens; older lines fit 1568px and
// cap at 1,568 tokens, downscaling past it.
// https://platform.claude.com/docs/en/build-with-claude/vision#evaluate-image-size
// The class default is the high-res tier, so ids without a revision
// (`claude-opus-latest`, `~anthropic/claude-sonnet-latest`) and future lines
// are never undercounted; only Opus/Sonnet/Haiku revisions known to predate
// 4.7 take the standard tier. Separator-collapsed revisions parse as two
// digits (`claude-opus-45` is Opus 4.5 → 45), so 10–46 is standard too.
// Claude's prompt cache finds an earlier request's entry only within 20 block
// positions back from a breakpoint, counting the breakpoint; a run of
// consecutive tool_use or tool_result blocks is one position. Warm-cache
// tool-result pruning keeps its rewrites inside this window.
// https://platform.claude.com/docs/en/build-with-claude/prompt-caching
// A replayed signed thinking block bills the full reasoning its signature
// carries (the server rebuilds it from the signature), at the size its turn
// billed as output, not the signature's bytes. Thinking a request drops bills
// nothing (earlier turns on lines that strip it: Opus before 4.5, Sonnet
// before 4.6, Haiku before 5.5; turns before a compaction or prune on
// prefix-bound lines; another model's blocks the reader cannot read), so
// those turns count high.
// https://platform.claude.com/docs/en/build-with-claude/context-windows#the-context-window-with-thinking
// https://platform.claude.com/docs/en/build-with-claude/preserved-thinking#switching-models
class "anthropic" {
	prompt-cache-lookback 20
	// Claude's input classifier refuses requests that quote earlier reasoning
	// back as text (`reasoning_extraction`, issue #6093).
	classifier-cot-extraction #true
	thinking-replay-tokens "output"
	// verified: billing matched this formula on Opus 4.7+ and Fable 5.1.
	image-tokenization {
		regime "anthropic-patch"
		verified #true
		max-edge 2576
		max-tokens 4784
	}
	family "opus" {
		revision "<4.7" {
			image-tokenization {
				regime "anthropic-patch"
				max-edge 1568
				max-tokens 1568
			}
		}
		revision ">=10 <47" {
			image-tokenization {
				regime "anthropic-patch"
				max-edge 1568
				max-tokens 1568
			}
		}
	}
	// Standard tier. verified: billing matched it on Sonnet 4.6 only; older
	// Sonnet lines keep the floor until measured.
	family "sonnet" {
		revision "<4.6" {
			image-tokenization {
				regime "anthropic-patch"
				max-edge 1568
				max-tokens 1568
			}
		}
		revision ">=4.6 <4.7" {
			image-tokenization {
				regime "anthropic-patch"
				verified #true
				max-edge 1568
				max-tokens 1568
			}
		}
		revision ">=10 <46" {
			image-tokenization {
				regime "anthropic-patch"
				max-edge 1568
				max-tokens 1568
			}
		}
		revision ">=46 <47" {
			image-tokenization {
				regime "anthropic-patch"
				verified #true
				max-edge 1568
				max-tokens 1568
			}
		}
	}
	family "haiku" {
		revision "<4.7" {
			image-tokenization {
				regime "anthropic-patch"
				max-edge 1568
				max-tokens 1568
			}
		}
		revision ">=10 <47" {
			image-tokenization {
				regime "anthropic-patch"
				max-edge 1568
				max-tokens 1568
			}
		}
	}
}

class "anthropic" {
	family "fable" {
		revision ">=5.1" {
			// Fable 5.1+ binds signed thinking to the exact preceding conversation.
			thinking-prefix-binding #true
		}
	}
	// Adaptive Claude (Opus 4.7+, Sonnet/Fable/Mythos 5+, Haiku 5.5+) rejects explicit
	// sampling params (`temperature`, `top_p`, `top_k`) with a 400 on every
	// serving host. The `<10` bound keeps whole-number revisions such as
	// `claude-opus-45` (Opus 4.5) out of the range.
	family "opus" {
		revision ">=4.7 <10" {
			supports-sampling-params #false
		}
	}
	// Opus 5.5 edits from imaged `read` results within one miss of text; Sonnet
	// and Haiku 5.5 miscount deep tab indents (measurements: rules/README.md).
	family "opus" {
		revision ">=5.5 <10" {
			snapcompact-image-reads #true
		}
	}
	family "sonnet" {
		revision ">=5 <10" {
			supports-sampling-params #false
		}
	}
	family "fable" {
		revision ">=5 <10" {
			supports-sampling-params #false
		}
	}
	family "mythos" {
		revision ">=5 <10" {
			supports-sampling-params #false
		}
	}
	family "haiku" {
		revision ">=5.5 <10" {
			supports-sampling-params #false
		}
		// Haiku 5.5 bills every rate 5x for prompts over 100K. Derived from each
		// host's list price so non-Anthropic hosts get the band too; the Claude
		// API and Cursor pin absolute rates, and GitHub Copilot opts out because
		// its long tier is the `-1m` sibling row.
		// https://platform.claude.com/docs/en/models/haiku-5-5/overview#pricing
		revision ">=5.5 <6" {
			long-context-cost {
				input-threshold 100000
				multiplier 5.0
			}
		}
	}
	// Opus 5.5 rejects forced tool selection the way Fable/Mythos do — a
	// `tool_choice` of `tool` or `any` fails the request with 400
	// `invalid_request_error`: `tool_choice: type "tool" and "any" are not
	// supported for this model`. This holds on every route, including Bedrock
	// Converse (`toolChoice: {any: {}}`). The transports downgrade the selector
	// to `auto` so the tool stays offered instead of the turn dying.
	//
	// Upper-bounded on purpose: separator-collapsed ids parse their revision
	// as a whole number (`claude-opus-45` is Opus 4.5, revision 45), so an
	// open `>=5.5` would silently catch them, and a later Opus generation has
	// to be re-verified against the API before it inherits the restriction.
	family "opus" {
		revision ">=5.5 <6" {
			// Opus 5.5 binds signed thinking to the exact preceding conversation, so a
			// replay fails once the system prompt, tools or earlier messages change.
			// Like the Sonnet 5.5 rule, this one spans every provider, so it changes
			// pruning, implicit prompt refreshes and thinking replay everywhere. On
			// Bedrock Converse it also sends `block_binding` with its beta.
			// https://platform.claude.com/docs/en/build-with-claude/preserved-thinking
			thinking-prefix-binding #true
			supports-forced-tool-choice #false
		}
	}
	// Sonnet 5.5 rejects forced tool selection like Opus 5.5 (400 `tool_choice:
	// type "tool" and "any" are not supported for this model`); upper-bounded
	// for the same reason as the Opus rule above.
	// https://platform.claude.com/docs/en/models/sonnet-5-5/whats-new-sonnet-5-5
	family "sonnet" {
		revision ">=5.5 <6" {
			supports-forced-tool-choice #false
			// `thinking: {type: "disabled"}` is a 400; `between_tools` is the
			// lowest thinking setting.
			// https://platform.claude.com/docs/en/models/sonnet-5-5/migration-guide#turn-off-up-front-thinking
			supports-between-tools-thinking #true
			// Signed thinking is bound to the exact preceding conversation.
			thinking-prefix-binding #true
		}
	}
	// Haiku 5.5 binds signed thinking to the exact preceding conversation like
	// Sonnet 5.5. It accepts a forced `tool_choice` (the response just skips
	// thinking), so it keeps forced tool selection.
	// https://platform.claude.com/docs/en/models/haiku-5-5/migration-guide
	family "haiku" {
		revision ">=5.5 <6" {
			thinking-prefix-binding #true
		}
	}
	on "github-copilot" {
		family "sonnet" {
			revision ">=3.7 <4.6" {
				thinking-mode "budget"
			}
		}
	}
	on "github-copilot" {
		family "haiku" {
			thinking-mode "budget"
			// Haiku 5.5 is the first adaptive Haiku: `budget_tokens` is a 400.
			// An omitted `thinking` is adaptive, but unlike Sonnet/Opus 5.5 it
			// accepts `disabled` at effort `high` or below, so Off is explicit.
			// https://platform.claude.com/docs/en/build-with-claude/prompt-engineering/prompting-claude-haiku-5-5#use-effort-to-control-thinking
			revision ">=5.5 <6" {
				thinking-mode "anthropic-adaptive"
				disabled-thinking "disabled"
			}
		}
	}
	on "github-copilot" {
		family "opus" {
			revision ">=4.5 <4.6" {
				thinking-mode "anthropic-budget-effort"
			}
		}
	}
	on "github-copilot" {
		family "opus" {
			revision ">=4.6 <4.7" {
				thinking-efforts "low" "medium" "high" "max"
			}
		}
	}
	on "github-copilot" {
		revision ">=4.7 <45.1" {
			thinking-mode "anthropic-adaptive"
		}
	}
	on "github-copilot" {
		revision ">=4.7 <45.1" {
			thinking-efforts "low" "medium" "high" "xhigh" "max"
		}
	}
	on "github-copilot" {
		family "sonnet" {
			revision ">=4.6 <5" {
				thinking-efforts "low" "medium" "high"
			}
		}
		revision ">=4.6 <4.7" {
			thinking-mode "anthropic-adaptive"
		}
	}
	// Claude 3.5 Haiku OAuth requests omit the Claude Code instruction.
	family "haiku" {
		revision "=3.5" {
			inject-claude-code-instruction #false
		}
	}

}

