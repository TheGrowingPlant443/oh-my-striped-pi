// Model-lineage compat for "deepseek"; regenerated from the frozen census using class taxonomy selectors.

class "deepseek" {
	// DeepSeek V4 uses the wire-exact low/high/max scale on every host.
	family "pro" {
		thinking-efforts "low" "high" "max"
	}
	family "flash" {
		thinking-efforts "low" "high" "max"
	}
	family "v4" {
		thinking-efforts "low" "high" "max"
	}
	family "r1" {
		thinking-efforts "high" "max"
	}
	family "v3" {
		thinking-efforts "high" "max"
	}
	family "reasoner" {
		thinking-efforts "high" "max"
	}
	strip-image-input #true
	models token="ocr" {
		strip-image-input #false
	}
	models token="vision" {
		strip-image-input #false
	}
	// DeepSeek V4.1 Flash is natively multimodal (image-text-to-text), but its
	// id carries no `vision` token, so the class-wide strip above dropped
	// attachments the model reads on every deployment without its own carve-out.
	// The glob also spans `-vision`/`-ocr` ids, which already set the same value
	// below, so the explicit priority resolves that equal-rank tie instead of
	// throwing AmbiguousOverlapError. Only the strip is disabled; the declared
	// modality stays host-derived, so endpoints whose OpenAI-compatible surface
	// rejects `image_url` keep their text-only contract.
	models "*v4.1-flash*" priority=10 {
		strip-image-input #false
	}
	// V4.1 Flash is natively multimodal (vision encoder + projector, image-text
	// pre-training) but its release id carries no `vision` token to key on.
	// The leading glob also covers publisher-namespaced ids (`ds/deepseek-flash`).
	// Same priority as the V4.1 Flash carve-out: the OpenCode Go provider rule
	// declares the same value for its `deepseek-flash` lane and would otherwise
	// tie at equal rank.
	models "*deepseek-flash" priority=10 {
		strip-image-input #false
	}
	thinking-loop-guard "deepseek"
	// V4 reasoning reaches omsp as its plaintext trace on every host, and the
	// revision pins the weights (flash 4.0 / 4.1, pro 4.0). Earlier lineages
	// classify too coarsely to carry: `r1` also matches the R1 distills.
	revision ">=4" {
		portable-reasoning #true
	}
	// V4.1 Flash's vision config (patch 14, 3x3 merge, 1024-token cap, 544²
	// floor). verified: OpenRouter billing matched it exactly on Fireworks and
	// DeepInfra and within one token on Together, 256px to 4000px.
	// Later Flash releases stay on their wire fallback until measured.
	family "flash" {
		revision ">=4.1 <4.2" {
			image-tokenization {
				regime "deepseek-patch"
				verified #true
				patch-size 14
				downsample 3
				max-tokens 1024
				min-pixels 295936
			}
		}
	}
}
