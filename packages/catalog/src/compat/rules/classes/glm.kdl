// Model-lineage compat for "glm"; regenerated from the frozen census using class taxonomy selectors.

class "glm" {
	// GLM-5.2 exposes the lower tiers plus max on generic OpenAI-compatible hosts.
	revision ">=5.2 <5.3" priority=10 {
		thinking-efforts "minimal" "low" "medium" "high" "max"
	}
	// GLM-5.3+ coding SKUs (base/air/turbo/flash/flashx) expose a uniform
	// wire-exact low/high/max reasoning-effort ladder on every host, thinking
	// can no longer be disabled, and the default effort is max.
	// residue: taxonomy ranks cannot separate these ids from the vision (`…v`)
	// and preview shapes that keep host dialects; the explicit priority resolves
	// the intentional overlap with census host-dialect residues such as
	// baseten's `zai-org/GLM-5*`.
	models "*glm-5.3" "*glm-5.3-air" "*glm-5.3-turbo" "*glm-5.3-flash" "*glm-5.3-flashx" "*glm-5.3:*" \
		"*glm-5.3-flash-uncensored" "*glm-5.3-free" "*glm-5.3-highspeed" "*glm-5.3-fast" "*glm-5.3-flash-lab" priority=10 {
		thinking-default-level "max"
		thinking-efforts "low" "high" "max"
		thinking-requires-effort #true
	}
	// GLM 5+ reasoning reaches omp as its plaintext trace on every host, and
	// family plus revision pin the weights (glm-5.2, glm-5.3-flash, ...). GLM 4
	// classifies too coarsely to carry: 4.0 also matches glm-4.5v and glm-4.6v.
	revision ">=5" {
		portable-reasoning #true
		// residue: fine-tuned weights that classify as the base GLM revision.
		models "*-uncensored" "*-cybersecurity" {
			portable-reasoning #false
		}
	}
}
