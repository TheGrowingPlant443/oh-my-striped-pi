// Model-lineage compat for "gemini"; regenerated from the frozen census using class taxonomy selectors.

class "gemini" {
	// Gemini ladders follow the model generation on every host: pre-3.0 keeps
	// the four-tier scale, Gemini 3+ Pro exposes only low/high, and the 3+
	// Flash/Lite lines keep the four-tier scale.
	family "pro" {
		// Replaces the Gemini 2.5+ Pro mandatory-reasoning fallback.
		revision ">=2.5 <3" {
			thinking-requires-effort #true
		}
		revision "<3" {
			thinking-efforts "minimal" "low" "medium" "high"
		}
		revision ">=3" {
			thinking-efforts "low" "high"
		}
	}
	family "flash" {
		revision ">=0" {
			thinking-efforts "minimal" "low" "medium" "high"
		}
	}
	family "lite" {
		revision ">=0" {
			thinking-efforts "minimal" "low" "medium" "high"
		}
	}

	revision ">=3" {
		// Replaces the Gemini 3+ mandatory-reasoning fallback.
		thinking-requires-effort #true
	}

	thinking-loop-guard "gemini"
}


// Gemini 3+ bills a fixed `media_resolution` budget per image regardless of
// pixels; the default for images is HIGH, 1,120 tokens.
// https://ai.google.dev/gemini-api/docs/media-resolution
class "gemini" {
	revision ">=3" {
		image-tokenization {
			regime "fixed"
			tokens 1120
		}
	}
}
