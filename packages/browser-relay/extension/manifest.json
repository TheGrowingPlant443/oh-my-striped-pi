{
	"manifest_version": 3,
	"name": "OMSP Browser Relay",
	"version": "0.1.0",
	"description": "Lets the omsp coding agent drive your existing tabs through a local CDP relay.",
	"author": "Stencil Labs, Inc.",
	"homepage_url": "https://github.com/TheGrowingPlant443/oh-my-striped-pi",
	"permissions": ["debugger", "tabs", "tabGroups", "storage", "alarms"],
	"background": {
		"service_worker": "background.js"
	},
	"options_page": "options.html",
	"action": {
		"default_title": "OMSP Browser Relay (click for settings)"
	}
}
