on-api "openai-completions" "openai-responses" priority=-1 {
	image-tokenization {
		regime "openai-patch"
		multiplier 1.2
		auto "original"
		low {
			max-edge 512
		}
		high {
			max-edge 2048
			patch-budget 2500
		}
		original {
			max-edge 6000
			patch-budget 10000
		}
	}
}

on-api "anthropic-messages" priority=-1 {
	image-tokenization {
		regime "anthropic-patch"
		max-edge 2576
		max-tokens 4784
	}
}
