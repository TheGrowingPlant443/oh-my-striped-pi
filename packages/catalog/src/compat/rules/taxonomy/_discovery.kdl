// Generic model-family discovery vocabulary.

discovery {
	// Billing-variant SKUs sharing a transport with their base id.
	billing-variant-suffix "-free" "-contributor"
	// Routing/quantization/serving markers a reseller or aggregator appends
	// to an upstream id (`:nitro`, `-fp8`, …) without changing model identity.
	// Effort/thinking suffixes come from the collapse vocabulary instead.
	// The effort/thinking/free tokens here are the reviewed canonical-safe
	// subset: `-max`, `-none`, and `-extra-high` name real product lanes and
	// MUST NOT coalesce, so they are deliberately absent.
	trailing-marker "customtools" "cloud" "exacto" "nitro" "original" "optimized" \
		"nvfp4" "fp8" "fp4" "bf16" "int8" "int4" \
		"thinking" "minimal" "low" "medium" "high" "xhigh" "free"
	// Identity-preserving ONLY when recovering bundled metadata for a proxied
	// id, never during canonical coalescing: Perplexity's `sonar-pro-search`
	// is a distinct model from `sonar-pro`, while `claude-opus-4-6-search`
	// on a proxy should still inherit upstream pricing/limits.
	reference-only-trailing-marker "search"
	// Vendor-lineage tokens anchoring generator-side canonical-family
	// extraction and attached-version separator insertion (`gpt5` -> `gpt-5`).
	// Broader than class taxonomy on purpose: open-weight lineages without a
	// compat class still coalesce across resellers.
	canonical-family-token "claude" "gemini" "gpt" "grok" "glm" "qwen" "minimax" "kimi" \
		"deepseek" "llama" "gemma" "nova" "mistral" "ministral" "pixtral" "codestral" \
		"devstral" "magistral" "ernie" "doubao" "seed" "aion" "olmo" "molmo" "nemotron" \
		"palmyra" "command" "codex" "coder"
	// Reseller wrapper prefixes and synthetic namespace prefixes stripped
	// during canonical candidate expansion.
	wrapper-prefix "duo-chat-"
	synthetic-prefix "hf:"
}
